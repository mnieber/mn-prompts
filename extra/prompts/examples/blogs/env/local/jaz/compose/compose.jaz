from ../python/python.jaz import (pip-compile) as python

🐭.script = ⚙️.module.dirname / "compose_tools.py"

# The default of local: whether to use the images of the Dockerfile.local files.
[private]
use-dockerfile-local():
    🐆.retval = ⚙️.get_config(path="/compose/use_dockerfile_local", default=false)

# Build the images of the services. With local=true, build them from the
# Dockerfile.local files (default: /compose/use_dockerfile_local). With no-cache, build
# without the docker cache.
[interactive]
build(local=🐭.use-dockerfile-local(), no-cache=""):
    🐆.local-flag = "--local" if 🐆.local else ""
    🐆.no-cache-flag = "--no-cache" if 🐆.no-cache else ""
    @⚙️.python 🐭.script build --root-dir=⚙️.root_module.dirname 🐆.local-flag 🐆.no-cache-flag

# Build the base images of the services. With no-cache, build without the docker cache.
[interactive]
build-base-images(no-cache=""):
    🐆.no-cache-flag = "--no-cache" if 🐆.no-cache else ""
    @⚙️.python 🐭.script build-base-images --root-dir=⚙️.root_module.dirname 🐆.no-cache-flag

# Start the stack. With local=true, use the images of the Dockerfile.local files
# (default: /compose/use_dockerfile_local).
[interactive]
up(local=🐭.use-dockerfile-local()):
    🐆.local-flag = "--local" if 🐆.local else ""
    @⚙️.python 🐭.script up --root-dir=⚙️.root_module.dirname 🐆.local-flag

# Stop the stack, and remove its containers. With volumes=true, also remove its
# volumes, so that the next up starts with a new and uninitialised stack.
[interactive]
down(volumes=false):
    🐆.volumes-flag = "--volumes" if 🐆.volumes else ""
    @⚙️.python 🐭.script down --root-dir=⚙️.root_module.dirname 🐆.volumes-flag

# Stop the stack, compile the requirements, build the images and start the stack.
[interactive]
restart(local=🐭.use-dockerfile-local(), no-cache=""):
    🐭.down()
    🐭.python.pip-compile()
    🐭.build(local=🐆.local, no-cache=🐆.no-cache)
    🐭.up(local=🐆.local)

# Run cmd (default: the command of the service) in a new container of service.
[interactive]
run(service, cmd="", local=🐭.use-dockerfile-local()):
    🐆.safe-service = 🐆.service | ⚙️.sh-quote
    🐆.safe-cmd = 🐆.cmd | ⚙️.sh-quote
    🐆.local-flag = "--local" if 🐆.local else ""
    @⚙️.python 🐭.script run --root-dir=⚙️.root_module.dirname --service=🐆.safe-service --cmd=🐆.safe-cmd 🐆.local-flag

# Compile the .env.in files of the services into .env files, with the values of
# secrets.env.
[interactive]
compile-env-files():
    @⚙️.python 🐭.script compile-env-files --root-dir=⚙️.root_module.dirname

# Initialise the stack: start it with the init-stack file, so that each service runs
# init-dev and then its server, and wait until the stack is healthy. Then check the
# homepage (/compose/init/homepage) and offer to open it in the browser.
[interactive]
init(local=🐭.use-dockerfile-local()):
    🐆.local-flag = "--local" if 🐆.local else ""
    @⚙️.python 🐭.script init --root-dir=⚙️.root_module.dirname 🐆.local-flag
