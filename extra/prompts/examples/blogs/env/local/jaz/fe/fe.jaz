🐭.script = ⚙️.module.dirname / "../service/service_tools.py"

# Run cmd in the container of blogs_fe (/services/fe/container), as user and in
# workdir if they are given.
[interactive]
exec(cmd, user="", workdir=""):
    🐆.container = ⚙️.get_config(path="/services/fe/container")
    @⚙️.python 🐭.script run --container=🐆!container --cmd=🐆!cmd --user=🐆!user --workdir=🐆!workdir

# Run the server of blogs_fe in its container.
[interactive]
run-server():
    🐭.exec(cmd="jaz run-server")

# Run the server of blogs_fe in its container.
[interactive]
install():
    🐭.exec(cmd="jaz install")

# Open a shell (/services/fe/shell) in the container of blogs_fe.
[interactive]
shell():
    🐆.shell = ⚙️.get_config(path="/services/fe/shell")
    🐭.exec(cmd=🐆.shell)
