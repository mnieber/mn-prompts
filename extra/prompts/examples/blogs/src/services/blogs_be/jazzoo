#
# Postgres
#

create-db():
    PGPASSWORD=${POSTGRES_PASSWORD} psql -h ${POSTGRES_HOST} -d postgres -U postgres -c "CREATE USER ${DJANGO_DATABASE_USER} WITH CREATEDB PASSWORD '${DJANGO_DATABASE_PASSWORD}';" || true
    PGPASSWORD=${DJANGO_DATABASE_PASSWORD} psql -h ${POSTGRES_HOST} -d postgres -U ${DJANGO_DATABASE_USER} -c "CREATE DATABASE ${DJANGO_DATABASE_NAME};" || true
    PGPASSWORD=${POSTGRES_PASSWORD} psql -h ${POSTGRES_HOST} -d postgres -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE ${DJANGO_DATABASE_NAME} TO ${DJANGO_DATABASE_USER};"

[interactive]
pgcli():
    pgcli `python manage.py sqldsn --quiet --style=uri`

#
# Django
#

collect-static():
    python manage.py collectstatic --link --noinput

create-superuser():
    python manage.py createsuperuser --noinput || true

# Marks the email of the superuser as verified, so that they can sign in.
verify-superuser-email():
    python manage.py verify_email ${DJANGO_SUPERUSER_EMAIL}

dump-db():
    mkdir -p /app/dumps && python manage.py dbbackup

migrate():
    python manage.py migrate

[interactive]
run-server():
    python manage.py runserver 0.0.0.0:8000

generateschema():
    python manage.py spectacular --file api/openapi-schema.yml --validate

#
# Tests
#

# Run tests, and open PuDB when a test fails. A kwargs value that starts with a dash is
# passed to pytest as it is (e.g. "-k mytest -x"). Any other value is the -k expression
# (e.g. "mytest"), and a name that ends with __ selects only the test with that name.
[interactive]
pytest(kwargs=""):
    🐆.safe-kwargs = 🐆.kwargs | ⚙️.sh-quote
    case 🐆.safe-kwargs in -*) set -- 🐆.kwargs ;; *) set -- -k 🐆.safe-kwargs ;; esac; pytest --pdbcls=pudb.debugger:Debugger --pdb --capture=no "$@"

#
# Stack
#

init-dev(): create-db() migrate() collect-static() create-superuser() verify-superuser-email()

# Succeeds when the server responds (the healthcheck of docker-compose.init-stack.yml).
check():
    python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/admin/login/', timeout=5)"

