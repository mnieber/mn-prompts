#
# React
#

install():
    yarn install

[interactive]
run-server():
    yarn dev --host

#
# Npm
#

# Build the package in package-dir and publish it to the npm registry. Logs in to npm
# when needed, and asks for confirmation before it publishes.
[interactive]
npm-publish(package-dir):
    🐆.script = ⚙️.module.dirname / "extra/jaz/npm_tools.py"
    🐆.safe-package-dir = 🐆.package-dir | ⚙️.sh-quote
    @⚙️.python 🐆.script publish --package-dir=🐆.safe-package-dir

#
# Stack
#

init-dev(): install()

# Succeeds when the server responds (the healthcheck of docker-compose.init-stack.yml).
check():
    wget -q -O /dev/null http://127.0.0.1:3000/

