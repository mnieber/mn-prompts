#
# React
#

install():
    yarn install

[interactive]
run-server():
    yarn dev --host

#
# Stack
#

init-dev(): install()

# Succeeds when the server responds (the healthcheck of docker-compose.init-stack.yml).
check():
    wget -q -O /dev/null http://127.0.0.1:3000/

create-opt-paths():
    sudo mkdir -p /opt/projects/blogs/blogs_fe
    sudo echo     "- cmd: echo 'start of the fish history'" >> /opt/projects/blogs/blogs_fe/fish_history
    sudo chmod -R 777 /opt/projects/blogs
